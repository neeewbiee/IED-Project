void setup()
{
  Serial.begin(9600);
  espSerial.begin(9600); 
  dht.begin();
}

  void loop()
  {
    int temp = dht11();
    espSerial.println(temp);
    ESP.restart();
    delay(1000);
  } 

int dht11() {
  delay(100);  // Wait a few seconds between measurements.
  float t = dht.readTemperature();

  if (isnan(t)) {
    Serial.println(F("Failed to read from DHT sensor!"));
    return;
  }
  return t;
}
