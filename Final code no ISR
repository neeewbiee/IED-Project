#include <SoftwareSerial.h>        //Software Serial library
SoftwareSerial espSerial(12, 13);  //Pin 2 and 3 act as RX and TX. Connect them to TX and RX of ESP8266
#define DEBUG true
String mySSID = "AndroidAPang";     // WiFi SSID
String myPWD = "pang6922";          // WiFi Password
String myAPI = "YEQ1SUPMM1ICC7P0";  // API Key
String myHOST = "api.thingspeak.com";
String myPORT = "80";
String myFIELD = "field1";
String myFIELD2 = "field2";

#include <Wire.h>
#include <LiquidCrystal_I2C.h>
LiquidCrystal_I2C lcd(0x27, 16, 2);

#include "DHT.h"
#define DHTPIN A1
#define DHTTYPE DHT11  // DHT 11
DHT dht(A1, DHT11);

#define motor_board_input_pin_IN1 9  //Connect to Arduino pin 9
#define motor_board_input_pin_IN2 6  //Connect to Arduino pin 6
#define motor_board_input_pin_IN3 5  //Connect to Arduino pin 5
#define motor_board_input_pin_IN4 3  //Connect to Arduino pin 3

#define TrigPin1 11
#define EchoPin1 10
#define TrigPin2 8
#define EchoPin2 7

#define moisture_sensor A0

void brake(void);
void move_forward(void);
void move_rev(void);
void Turn_right(void);
void Turn_left(void);
int Ultrasonic1(int EchoPin, int TrigPin);
int Ultrasonic2(int EchoPin, int TrigPin);
int MoistureSensor(void);
void TargetBoardA(void);
void TargetBoardB(void);
int dht11(void);
void movement(int Distance1, int Distance2);
void wifi(void);
void TargetBoard(void);

int counterA = 0;
int counterB = 0;

void setup() {
  Serial.begin(9600);
  pinMode(motor_board_input_pin_IN1, OUTPUT);
  pinMode(motor_board_input_pin_IN2, OUTPUT);
  pinMode(motor_board_input_pin_IN3, OUTPUT);
  pinMode(motor_board_input_pin_IN4, OUTPUT);

  pinMode(TrigPin1, OUTPUT);
  pinMode(EchoPin1, INPUT);
  pinMode(TrigPin2, OUTPUT);
  pinMode(EchoPin2, INPUT);

  lcd.init();
  lcd.begin(16, 2);
  lcd.backlight();

  pinMode(2, INPUT_PULLUP);
  pinMode(4, INPUT_PULLUP);

  dht.begin();

  espSerial.begin(9600);
  espData("AT+RST", 500, DEBUG);                                         //Reset the ESP8266 module
  espData("AT+CWMODE=1", 500, DEBUG);                                    //Set the ESP mode as station mode
  espData("AT+CWJAP=\"" + mySSID + "\",\"" + myPWD + "\"", 500, DEBUG);  //Connect to WiFi network
}

void loop() {
  int Distance1 = Ultrasonic1(EchoPin1, TrigPin1);
  int Distance2 = Ultrasonic2(EchoPin2, TrigPin2);
  TargetBoard();
  movement(Distance1, Distance2);
  TargetBoardB();
  wifi();
}

void move_forward() {
  digitalWrite(motor_board_input_pin_IN2, LOW);
  digitalWrite(motor_board_input_pin_IN1, HIGH);  //motor A lower forward speed
  digitalWrite(motor_board_input_pin_IN3, LOW);
  digitalWrite(motor_board_input_pin_IN4, HIGH);  // motor B higher reverse speed
  delay(1000);
}

void brake() {
  digitalWrite(motor_board_input_pin_IN1, HIGH);
  digitalWrite(motor_board_input_pin_IN2, HIGH);
  digitalWrite(motor_board_input_pin_IN3, HIGH);
  digitalWrite(motor_board_input_pin_IN4, HIGH);
  delay(500);
}

void move_rev() {
  digitalWrite(motor_board_input_pin_IN2, HIGH);
  digitalWrite(motor_board_input_pin_IN1, LOW);  //motor A lower forward speed
  digitalWrite(motor_board_input_pin_IN3, HIGH);
  digitalWrite(motor_board_input_pin_IN4, LOW);  // motor B higher reverse speed
  delay(1000);
}

void Turn_left() {
  digitalWrite(motor_board_input_pin_IN2, LOW);
  analogWrite(motor_board_input_pin_IN1, 90);  //motor A lower forward speed
  digitalWrite(motor_board_input_pin_IN3, LOW);
  analogWrite(motor_board_input_pin_IN4, 200);  // motor B higher reverse speed
  delay(1000);
}

void Turn_right() {
  digitalWrite(motor_board_input_pin_IN2, LOW);
  analogWrite(motor_board_input_pin_IN1, 200);  //motor A higher forward speed
  digitalWrite(motor_board_input_pin_IN3, LOW);
  analogWrite(motor_board_input_pin_IN4, 90);  // motor B lower reverse speed
  delay(1000);
}

int Ultrasonic1(int EchoPin, int TrigPin) {
  int Distance;
  long pulseDuration;

  digitalWrite(TrigPin1, LOW);
  delayMicroseconds(2);
  digitalWrite(TrigPin1, HIGH);
  delayMicroseconds(10);
  digitalWrite(TrigPin1, LOW);

  pulseDuration = pulseIn(EchoPin1, HIGH);
  Distance = pulseDuration / 58;

  return Distance;
}

int Ultrasonic2(int EchoPin, int TrigPin) {
  int Distance;
  long pulseDuration;

  digitalWrite(TrigPin2, LOW);
  delayMicroseconds(2);
  digitalWrite(TrigPin2, HIGH);
  delayMicroseconds(10);
  digitalWrite(TrigPin2, LOW);

  pulseDuration = pulseIn(EchoPin2, HIGH);
  Distance = pulseDuration / 58;

  return Distance;
}

int MoistureSensor() {
  float moisture_percentage;
  int sensor_analog;
  sensor_analog = analogRead(moisture_sensor);
  moisture_percentage = (100 - ((sensor_analog / 1023.00) * 100));

  return moisture_percentage;
}

void TargetBoardA() {
  Serial.print("A score is:");
  Serial.print(counterA);
  //must reset after 3 for 3 diff modes(moisture,temp,light)
  if (counterA == 0) {
    //no light
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(" No Light");
  } else if (counterA == 1) {
    //light
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Light");
    brake();
  } else if (counterA >= 2) {
    counterA = 0;
  }
}

void TargetBoardB() {
  //must reset after 3 for 3 diff modes(moisture,temp,light)
  if (counterB == 0) {
    // moisture
    int moisture = MoistureSensor();
    lcd.setCursor(0, 0);
    lcd.print("Moisture %");
    delay(100);
    lcd.setCursor(0, 1);
    lcd.print(moisture);
  } else if (counterB == 1) {
    //temp
    int temp = dht11();
    lcd.setCursor(0, 0);
    lcd.print("Temperature");
    delay(100);
    lcd.setCursor(0, 1);
    lcd.print(temp);
  } else if (counterB == 2) {
    //show sunlight
    TargetBoardA();
  } else if (counterB >= 3) {
    lcd.clear();
    delay(100);
    counterB = 0;
  }
}

void TargetBoards() {
  if (!digitalRead(4))
    counterA++;
  else if (!digitalRead(2))
    counterB++;
}

int dht11() {
  delay(100);  // Wait a few seconds between measurements.
  float t = dht.readTemperature();

  if (isnan(t)) {
    Serial.println(F("Failed to read from DHT sensor!"));
    return;
  }
  return t;
}

void movement(int Distance1, int Distance2) {
  if (counterA == 0) {
    if (Distance1 < 50) {
      brake();
      move_rev();
      Turn_left();
    } else if (Distance2 < 50) {
      brake();
      move_rev();
      Turn_left();
    } else if (Distance1 < 50 && Distance2 < 50) {
      brake();
      Turn_right();
    } else {
      move_forward();
    }
  } else if (counterA == 1) {
    brake();
  } else if (counterA >= 2) {
    counterA = 0;
  }
}

void wifi() {
  int temp = dht11();
  int moisture = MoistureSensor();
  String sendData = "GET /update?api_key=" + myAPI + "&" + myFIELD + "=" + String(temp) + "&" + myFIELD2 + "=" + String(moisture);
  espData("AT+CIPMUX=1", 500, DEBUG);  //Allow multiple connections
  espData("AT+CIPSTART=0,\"TCP\",\"" + myHOST + "\"," + myPORT, 500, DEBUG);
  espData("AT+CIPSEND=0," + String(sendData.length() + 4), 500, DEBUG);
  espSerial.find(">");
  espSerial.println(sendData);
  espData("AT+CIPCLOSE=0", 500, DEBUG);
}

String espData(String command, const int timeout, boolean debug) {
  Serial.print("AT Command ==> ");
  Serial.print(command);
  Serial.println("     ");

  String response = "";
  espSerial.println(command);
  long int time = millis();
  while ((time + timeout) > millis()) {
    while (espSerial.available()) {
      char c = espSerial.read();
      response += c;
    }
  }
  if (debug) {
    //Serial.print(response);
  }
  return response;
}
