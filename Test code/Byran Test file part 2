#include <Wire.h>
#include <LiquidCrystal_I2C.h>
LiquidCrystal_I2C lcd(0x27, 16, 2);

#include "DHT.h"
#define DHTPIN A1
#define DHTTYPE DHT11  // DHT 11
DHT dht(A1, DHT11);

#define motor_board_input_pin_IN1 9  //Connect to Arduino pin 9
#define motor_board_input_pin_IN2 6  //Connect to Arduino pin 6
#define motor_board_input_pin_IN3 5  //Connect to Arduino pin 5
#define motor_board_input_pin_IN4 3  //Connect to Arduino pin 3

#define TrigPin1 11
#define EchoPin1 10
#define TrigPin2 8
#define EchoPin2 7

#define moisture_sensor A0

void brake(void);
void move_forward(void);
void move_rev(void);
void Turn_right(void);
void Turn_left(void);
int Ultrasonic1(int EchoPin, int TrigPin);
int Ultrasonic2(int EchoPin, int TrigPin);
int MoistureSensor(void);
void TargetBoardA(void);
void TargetBoardB(void);
int dht11(void);

int counterA = 0;
int counterB = 0;

void setup() {
  Serial.begin(9600);
  pinMode(motor_board_input_pin_IN1, OUTPUT);
  pinMode(motor_board_input_pin_IN2, OUTPUT);
  pinMode(motor_board_input_pin_IN3, OUTPUT);
  pinMode(motor_board_input_pin_IN4, OUTPUT);

  pinMode(TrigPin1, OUTPUT);
  pinMode(EchoPin1, INPUT);
  pinMode(TrigPin2, OUTPUT);
  pinMode(EchoPin2, INPUT);

  lcd.init();
  lcd.begin(16, 2);
  lcd.backlight();

  pinMode(2, INPUT_PULLUP);
  pinMode(4, INPUT_PULLUP);
  PCICR |= B00000100;
  PCMSK2 |= B00010100;

  dht.begin();
}

void loop() {


  TargetBoardB();
  int Distance1 = Ultrasonic1(EchoPin1, TrigPin1);
  int Distance2 = Ultrasonic2(EchoPin2, TrigPin2);
  Serial.println();
  Serial.print("Distance 1 = ");
  Serial.print(Distance1);
  Serial.print(" Distance 2 = ");
  Serial.print(Distance2);
  if (Distance1 < 50) {
    brake();
    move_rev();
    Turn_left();
  } else if (Distance2 < 50) {
    brake();
    move_rev();
    Turn_left();
  } else if (Distance1 < 50 && Distance2 < 50) {
    brake();
    Turn_right();
  } else {
    move_forward();
  }
  delay(100);
}

void move_forward() {
  digitalWrite(motor_board_input_pin_IN2, LOW);
  digitalWrite(motor_board_input_pin_IN1, HIGH);  //motor A lower forward speed
  digitalWrite(motor_board_input_pin_IN3, LOW);
  digitalWrite(motor_board_input_pin_IN4, HIGH);  // motor B higher reverse speed
  delay(1000);
}

void brake() {
  digitalWrite(motor_board_input_pin_IN1, HIGH);
  digitalWrite(motor_board_input_pin_IN2, HIGH);
  digitalWrite(motor_board_input_pin_IN3, HIGH);
  digitalWrite(motor_board_input_pin_IN4, HIGH);
  delay(1000);
}

void move_rev() {
  digitalWrite(motor_board_input_pin_IN2, HIGH);
  digitalWrite(motor_board_input_pin_IN1, LOW);  //motor A lower forward speed
  digitalWrite(motor_board_input_pin_IN3, HIGH);
  digitalWrite(motor_board_input_pin_IN4, LOW);  // motor B higher reverse speed
  delay(1000);
}

void Turn_left() {
  digitalWrite(motor_board_input_pin_IN2, LOW);
  analogWrite(motor_board_input_pin_IN1, 90);  //motor A lower forward speed
  digitalWrite(motor_board_input_pin_IN3, LOW);
  analogWrite(motor_board_input_pin_IN4, 200);  // motor B higher reverse speed
  delay(1000);
}

void Turn_right() {
  digitalWrite(motor_board_input_pin_IN2, LOW);
  analogWrite(motor_board_input_pin_IN1, 200);  //motor A higher forward speed
  digitalWrite(motor_board_input_pin_IN3, LOW);
  analogWrite(motor_board_input_pin_IN4, 90);  // motor B lower reverse speed
  delay(1000);
}

int Ultrasonic1(int EchoPin, int TrigPin) {
  int Distance;
  long pulseDuration;

  digitalWrite(TrigPin1, LOW);
  delayMicroseconds(2);
  digitalWrite(TrigPin1, HIGH);
  delayMicroseconds(10);
  digitalWrite(TrigPin1, LOW);

  pulseDuration = pulseIn(EchoPin1, HIGH);
  Distance = pulseDuration / 58;

  return Distance;
}

int Ultrasonic2(int EchoPin, int TrigPin) {
  int Distance;
  long pulseDuration;

  digitalWrite(TrigPin2, LOW);
  delayMicroseconds(2);
  digitalWrite(TrigPin2, HIGH);
  delayMicroseconds(10);
  digitalWrite(TrigPin2, LOW);

  pulseDuration = pulseIn(EchoPin2, HIGH);
  Distance = pulseDuration / 58;

  return Distance;
}

int MoistureSensor() {
  float moisture_percentage;
  int sensor_analog;
  sensor_analog = analogRead(moisture_sensor);
  moisture_percentage = (100 - ((sensor_analog / 1023.00) * 100));

  return moisture_percentage;
}

void TargetBoardA() {
  Serial.print("A score is:");
  Serial.print(counterA);
  //must reset after 3 for 3 diff modes(moisture,temp,light)
  if (counterA == 0) {
    //no light
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(" No Light");
    return;
    // Maybe can make into a function for movement
  } else if (counterA == 1) {
    //light
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Light");
    brake();
  } else if (counterA >= 2) {
    counterA = 0;
  }
}

void TargetBoardB() {
  //must reset after 3 for 3 diff modes(moisture,temp,light)
  if (counterB == 0) {
    // moisture
    int moisture = MoistureSensor();
    lcd.setCursor(0, 0);
    lcd.print("Moisture %");
    delay(100);
    lcd.setCursor(0, 1);
    lcd.print(moisture);
    Serial.print(" Moisture Percentage = ");
    Serial.print(moisture);
    Serial.println();
  } else if (counterB == 1) {
    //temp
    int temp = dht11();
    lcd.setCursor(0, 0);
    lcd.print("Temperature");
    delay(100);
    lcd.setCursor(0, 1);
    lcd.print(temp);
    Serial.print(" Temp = ");
    Serial.print(temp);
    Serial.println();
  } else if (counterB == 2) {
    //show sunlight
    TargetBoardA();
  } else if (counterB >= 3) {
    lcd.clear();
    counterB = 0;
  }
}

ISR(PCINT2_vect) {
  if (!digitalRead(2))
    counterA++;
  else if (!digitalRead(4))
    counterB++;
}

int dht11() {
  delay(100);  // Wait a few seconds between measurements.
  float t = dht.readTemperature();

  if (isnan(t)) {
    Serial.println(F("Failed to read from DHT sensor!"));
    return;
  }
  Serial.print(F(" Temperature: "));
  Serial.print(t);
  Serial.print(F("°C "));

  return t;
}

