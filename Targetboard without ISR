#define TargetA 4
#define TargetB 2

int counterA = 0;
int counterB = 0;

void targetboards(int targetboardA, int targetboardB);

void setup() {
  Serial.begin(9600);
  pinMode(TargetA, INPUT_PULLUP);
  pinMode(TargetB, INPUT_PULLUP);
}

void loop(){
  int targetboardA = digitalRead(TargetA);
  int targetboardB = digitalRead(TargetB);
  targetboards(targetboardA, targetboardB);
if (counterA == 2){
Serial.print("A");
}
if (counterB == 2) {
Serial.print("B");
}
  Serial.println();
  Serial.print(counterA);
  Serial.print(counterB);
}

void targetboards(int targetboardA, int targetboardB){
  if (targetboardA == 0){
    counterA++;
    while (targetboardA == 0){
      targetboardA = digitalRead(TargetA);
    }
  }
  if (targetboardB == 0){
    counterB++;
    while (targetboardB == 0){
      targetboardB = digitalRead(TargetB);
    }
  }
}
