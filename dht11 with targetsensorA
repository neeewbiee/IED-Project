#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <dht.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

#define TargetA 2 //Target sensor 1
#define TargetB 4 //Target sensor 2
#define DHT11_PIN A1

dht DHT;

int counterA = 0;
int counterB = 0;

void setup() {
    Serial.begin(9600);

    pinMode(TargetA, INPUT_PULLUP);
    pinMode(TargetB, INPUT_PULLUP);

    PCICR |= B00000100;    // Enable interrupts on PD port
    PCMSK2 |= B00010100;   // Trigger interrupts on pins D2 and D4

    lcd.init();
    lcd.begin(16, 2);
    lcd.backlight();
    lcd.clear();
}

void loop() {
    dht11();  // Always display temperature and humidity
    Target_SensorA();  // Check if TargetA is hit

    // Wait until one of the sensors is triggered
    while ((!digitalRead(TargetA)) && (!digitalRead(TargetB))) {
        delay(500);
    }
}

ISR(PCINT2_vect) {
    if (!digitalRead(TargetA)) {
        counterA++;
        Target_SensorA();  // Update LCD when TargetA is hit
    }

    if (counterA == 2) {
        resetCounter();  // Reset when counterA hits 2
    }

    if (!digitalRead(TargetB)) {
        counterB++;
    }
}

void Target_SensorA() {
    if (counterA == 1) {
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("There is Light");
        lcd.setCursor(0, 1);
        noInterrupts();  // Disable interrupts temporarily
    }
    else if (counterA == 2) {
        lcd.clear();
        lcd.setCursor(0, 0);
        lcd.print("There is no Light");
        lcd.setCursor(0, 1);
        noInterrupts();  // Disable interrupts temporarily
        counterA = 0;  // Reset the counter
    }
}

void resetCounter() {
    counterA = 0;  // Reset counterA when needed
    Target_SensorA();  // Refresh the LCD display
}

void dht11() {
    int chk = DHT.read11(DHT11_PIN);  // Read the DHT11 sensor
    lcd.setCursor(0, 0);
    lcd.print("Temp: ");
    lcd.print(DHT.temperature);
    lcd.print((char)223);  // Degree symbol
    lcd.print("C");

    lcd.setCursor(0, 1);
    lcd.print("Humidity: ");
    lcd.print(DHT.humidity);
    lcd.print("%");
    delay(1000);  // Update every 1 second
}
