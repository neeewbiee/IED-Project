#include <Wire.h>
#include <LiquidCrystal_I2C.h>
LiquidCrystal_I2C lcd(0x27, 16, 2);

#include "DHT.h"
#define DHTPIN A1
#define DHTTYPE DHT11  // DHT 11
DHT dht(A1, DHT11);

#define TargetA 2 // Target sensor 1
#define TargetB 4 //Target sensor 2

#define moisture_sensor A0

int counterA = 0;
int counterB = 0;
float t; //temperature

void setup() {
    Serial.begin(9600);
    
    pinMode(TargetA, INPUT_PULLUP);  // Set TargetA as input with pull-up resistor
    pinMode(TargetB, INPUT_PULLUP);
    PCICR |= B00000100;    // Enable interrupts on PD port (Pin D2)
    PCMSK2 |= B00000100;   // Trigger interrupts on pin D2 (TargetA)
    
    lcd.init();
    lcd.begin(16, 2);
    lcd.backlight();
    lcd.clear();
    dht.begin();
}

void loop() {
    t = dht.readTemperature();  // Read temperature 
    TargetBoardB();
  

    // If sensor is hit again, reset the counter
    while ((!digitalRead(TargetA)) && (!digitalRead(TargetB))) {
        // Wait for laser to hit the sensor (this prevents the loop from continuing without a hit)
        delay(500);  // Small delay to avoid overloading the system
    }

    // After laser is detected, reset counterA and show the message
    if (counterA == 2) {
        counterA = 0;  // Reset counterA to 0
    }
    if (counterB == 2) {
        counterB = 0;  // Reset counterB to 0
    }
}

ISR(PCINT2_vect) {  // Interrupt service routine for pin change interrupt
    if (!digitalRead(TargetA)){  // Check if TargetA is triggered (laser hit)
        counterA++;  // Increase counterA when laser is detected
  }
    else if (!digitalRead(4)){
     counterB++;  // Increase counterB when laser is detected
  }
}

// Function to update the LCD when TargetA is hit
void Target_SensorA() {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Temp: ");
    lcd.print(t);  // Display temperature
if (counterA == 0) {
    lcd.setCursor(0, 1);
    lcd.print("Got Light");
} 
else if (counterA > 0) {
    lcd.setCursor(0, 1);
    lcd.print("No Light");
}
    dht11();
}

void TargetBoardB() {
  Serial.print("B score is:");
  Serial.print(counterB);
  //must reset after 3 for 3 diff modes(moisture,temp,light)
  if (counterB == 0) {
    // moisture
    MoistureSensor();
  } 
  else if (counterB > 1) {
    //temp and light
  Target_SensorA();
  }
}

int MoistureSensor() {
  float moisture_percentage;
  int sensor_analog;
  sensor_analog = analogRead(moisture_sensor);
  moisture_percentage = (100 - ((sensor_analog / 1023.00) * 100));

  return moisture_percentage;
}

void dht11() {
  delay(100);  // Wait a few seconds between measurements.
  

  if (isnan(t)) {
    Serial.println(F("Failed to read from DHT sensor!"));
    return;
  }
  Serial.print(F(" Temperature: "));
  Serial.print(t);
  Serial.print(F("°C "));
}
